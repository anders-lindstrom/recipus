# Postgres. Dev container suggested in README (port 5434 to avoid clashing with
# longhaul's 5433).
DATABASE_URL=postgres://recipus:recipus@localhost:5434/recipus

# --- Auth -------------------------------------------------------------------
# Recipus authenticates every request itself and never trusts the network.
# In production Nginx Proxy Manager sits in front, Authelia does the 2FA, and
# NPM injects both the proxy secret and the authenticated username.
#
# PROXY_AUTH_SECRET must be set before deploy or every request is rejected and
# the app looks dead. There is deliberately no default.
PROXY_AUTH_SECRET=

# Header NPM uses to pass the Authelia-authenticated username through.
PROXY_USER_HEADER=Remote-User

# Dev only: when set, requests with no proxy headers are treated as this user
# so you can run the app locally without Authelia in front. Ignored entirely
# when NODE_ENV=production, so leaving it in a production .env is harmless —
# but leave it out anyway, so nobody has to check that claim under pressure.
DEV_AUTH_USER=anders

# --- Recipe import ----------------------------------------------------------
# Optional. Without it, URL import still works for any site publishing
# schema.org/Recipe JSON-LD; only the LLM fallback for unstructured pages is
# disabled.
ANTHROPIC_API_KEY=

# --- Catalog seeding --------------------------------------------------------
# The server re-seeds categories, the Swedish catalog and the starter list on
# every boot (src/instrumentation.ts). The seed is idempotent and never
# overwrites what the household owns — has_at_home, use_count, last_used_at —
# so this is how a deploy that adds catalog items ships them.
#
# Unset means: on in production, off in dev (use `pnpm db:seed` locally).
# Set to 1 or 0 to force it either way.
# SEED_ON_BOOT=

# --- Production only --------------------------------------------------------
# On the beelink these are set in ~/services/recipus/.env, not here:
#   DATABASE_URL=postgres://recipus:<password>@postgres:5432/recipus
#   PROXY_AUTH_SECRET=<openssl rand -hex 32, matching the NPM injected header>
# and DEV_AUTH_USER is omitted. See docs/deploy.md.
